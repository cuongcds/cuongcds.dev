---
import Site from '../layouts/Site.astro';
---
<Site page={{ path: '/404.html', title: 'Page not found — palash.dev', description: 'This page does not exist. Return to Palash Debnath’s work, writing, screenshots, or site search.', image: '/social/home.png', kind: 'WebPage', noIndex: true }}>
  <section class="game-over">
    <h1 class="game-over-title">Game over</h1>
    <p class="game-over-sub">404 — that page is not in this arcade.</p>
    <nav class="game-over-actions" aria-label="Recovery">
      <a class="pill" href="/">Home</a>
      <a class="pill" href="/blog/">Writing</a>
      <a class="pill" href="/media/">Screenshots</a>
      <a class="pill" href="/search/">Search</a>
    </nav>
    <p class="game-over-coin">Insert coin to continue</p>
  </section>
</Site>
