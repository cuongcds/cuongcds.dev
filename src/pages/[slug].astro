---
import Site from '../layouts/Site.astro';
import Gallery from '../islands/solid/Gallery';
import ProductMark from '../components/ProductMark.astro';
import { products, gallery, posts, type Product } from '../lib/content';
import { pageByPath } from '../lib/page-data';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.id }, props: { product } })); }
interface Props { product: Product }
const { product: p } = Astro.props;
const shots = gallery.filter(s => s.group === p.id);
const related = posts.filter(post => post.tags.includes(p.id));
---
<Site page={pageByPath(`/${p.id}/`)}>
  <section class={`product-hero product-${p.id}`} aria-labelledby="product-title">
    <div class="product-copy">
      <a class="back-link" href="/">← Workshop</a>
      <p class="product-kicker">{p.category.replace('Application', '')} · {p.status}</p>
      <h1 id="product-title">{p.name}</h1>
      <p class="product-lede">{p.tagline}</p>
      <p class="product-summary">{p.description}</p>
      <nav class="product-actions" aria-label={`${p.name} links`}>
        {p.website && <a class="pill" href={p.website}>Open product ↗</a>}
        <a href={p.github ?? p.url}>Source ↗</a>
        {p.github && <a href={`${p.github}/releases`}>Releases ↗</a>}
      </nav>
    </div>
    <aside class="machine-dossier" aria-label={`${p.name} dossier`}>
      <div class="dossier-top"><span>Machine dossier</span><span>{p.id.toUpperCase()}</span></div>
      <div class="dossier-mark"><span class="dossier-ring" aria-hidden="true"></span><ProductMark id={p.id} /></div>
      <dl>{p.proof.map(item => <div><dt>{item.value}</dt><dd>{item.label}</dd></div>)}</dl>
      <p>{p.license} · {p.os}</p>
    </aside>
  </section>
  {p.status === 'alpha' && p.id === 'bootable' && <aside class="safety-note"><strong>Field warning</strong><span>Writing erases the selected device. Check the target and keep backups.</span></aside>}
  <section class="build-record" aria-labelledby="build-record"><p>Build record</p><h2 id="build-record">Inside the machine</h2><ul>{p.stack.map(item => <li>{item}</li>)}</ul></section>
  {p.features.length > 0 && <section class="capabilities"><h2>Capabilities</h2><div>{p.features.map((f, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{f.title}</h3><p>{f.description}</p></article>)}</div></section>}
  {p.tables.map(t => <section><h2>{t.heading}</h2>{t.lead && <p>{t.lead}</p>}<div class="table-scroll" tabindex="0" role="region" aria-label={`${t.heading} table`}><table><thead><tr>{t.columns.map(c => <th scope="col">{c}</th>)}</tr></thead><tbody>{t.rows.map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(c => <td>{c}</td>)}</tr>)}</tbody></table></div>{t.footnote && <p>{t.footnote}</p>}</section>)}
  {shots.length > 0 && <section><h2>Screenshots</h2><Gallery client:visible shots={shots} /></section>}
  {related.length > 0 && <section><h2>Related writing</h2><ul>{related.map(post => <li><a href={`/blog/${post.id}/`}>{post.title}</a></li>)}</ul></section>}
</Site>

<style>
  .product-hero { --machine-accent: #397c79; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); gap: clamp(32px, 6vw, 80px); width: min(1080px, calc(100vw - 36px)); margin-inline: 50%; transform: translateX(-50%); }
  .product-bootable { --machine-accent: #a94b42; }.product-memxt { --machine-accent: #71844c; }.product-opal { --machine-accent: #66587c; }.product-opengtm { --machine-accent: #9a693f; }.product-friday { --machine-accent: #536d83; }
  .product-copy { min-width: 0; align-self: center; }
  .back-link { display: inline-block; margin-bottom: 28px; font-family: 'IBM Plex Mono', monospace; font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .product-kicker { margin: 0 0 8px; color: var(--machine-accent); font-family: 'IBM Plex Mono', monospace; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .product-hero h1 { margin-bottom: 12px; font-size: clamp(2.2rem, 5vw, 4.5rem); }
  .product-lede { margin: 0 0 22px; color: #303645; font-size: clamp(1.15rem, 2vw, 1.35rem); }
  .product-summary { max-width: 58ch; }
  .product-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 28px; font-family: 'IBM Plex Mono', monospace; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .machine-dossier { position: relative; min-width: 0; align-self: center; padding: 18px; color: #ede7d8; background: #111722; border: 3px solid #171a22; border-radius: 16px; box-shadow: 9px 9px 0 #15101c; overflow: hidden; }
  .machine-dossier::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(237, 231, 216, .035) 0 1px, transparent 1px 4px); pointer-events: none; }
  .dossier-top { position: relative; display: flex; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid #596176; color: #9eb56a; font-family: 'IBM Plex Mono', monospace; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .dossier-mark { position: relative; display: grid; place-items: center; min-height: 200px; }
  .dossier-mark :global(.product-mark) { position: relative; width: 150px; }
  .dossier-ring { position: absolute; width: 190px; aspect-ratio: 1; border: 1px solid var(--machine-accent); border-radius: 50%; opacity: .38; box-shadow: 0 0 0 18px rgba(255,255,255,.02), 0 0 0 36px rgba(255,255,255,.015); }
  .machine-dossier dl { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0; }
  .machine-dossier dl div { min-width: 0; padding-top: 10px; border-top: 2px solid var(--machine-accent); }
  .machine-dossier dt { color: #ede7d8; font-family: Bungee, system-ui, sans-serif; font-size: .9rem; line-height: 1.15; }
  .machine-dossier dd { margin: 5px 0 0; padding: 0; border: 0; color: #aab0bc; font-size: .65rem; line-height: 1.3; }
  .machine-dossier > p { position: relative; margin: 18px 0 0; color: #7f8796; font-family: 'IBM Plex Mono', monospace; font-size: .6rem; letter-spacing: .05em; text-transform: uppercase; }
  .safety-note { display: flex; gap: 16px; margin: 40px 0 0; padding: 14px 18px; color: #5b2d29; background: #e3d0c8; border-left: 6px solid #a94b42; }
  .safety-note strong { flex: 0 0 auto; font-family: 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .build-record { margin-top: 56px; }
  .build-record > p { margin: 0 0 7px; color: #326e6a; font-family: 'IBM Plex Mono', monospace; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .build-record h2 { margin-top: 0; }
  .build-record ul { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .build-record li { padding: 5px 10px; border: 1px solid #8b8375; border-radius: 999px; font-family: 'IBM Plex Mono', monospace; font-size: .7rem; }
  .capabilities > div { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .capabilities article { position: relative; margin: 0; padding-top: 42px; }
  .capabilities article > span { position: absolute; top: 14px; right: 16px; color: #b7ad9d; font-family: Bungee, system-ui, sans-serif; font-size: 2.4rem; line-height: 1; }
  .capabilities h3 { position: relative; margin-top: 0; }
  .capabilities p { position: relative; }
  .table-scroll { max-width: 100%; overflow-x: auto; padding: 0 5px 5px 0; }
  .table-scroll:focus-visible { outline: 3px solid var(--machine-accent); outline-offset: 3px; }
  @media (max-width: 760px) {
    .product-hero { grid-template-columns: 1fr; width: min(100vw - 24px, 1080px); }
    .machine-dossier { order: -1; }
    .back-link { margin-bottom: 20px; }
    .product-hero h1 { font-size: clamp(2rem, 9vw, 3.4rem); overflow-wrap: anywhere; }
    .safety-note { align-items: flex-start; flex-direction: column; gap: 4px; }
  }
</style>
