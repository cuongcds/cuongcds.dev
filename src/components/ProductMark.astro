---
interface Props { id: string }
const { id } = Astro.props;
---
<svg class="product-mark" viewBox="0 0 120 96" aria-hidden="true">
  <rect x="3" y="3" width="114" height="90" rx="16" fill="#101620" stroke="currentColor" stroke-width="3"/>
  {id === 'omnivoice' && <g fill="none" stroke="currentColor" stroke-linecap="round">
    <rect x="48" y="20" width="24" height="40" rx="12" stroke-width="5"/>
    <path d="M38 48c0 14 9 23 22 23s22-9 22-23M60 71v12M48 83h24" stroke-width="5"/>
    <path d="M26 38v14m68-14v14M18 42v6m84-6v6" stroke-width="3" opacity=".65"/>
  </g>}
  {id === 'bootable' && <g fill="none" stroke="currentColor" stroke-linejoin="round">
    <path d="M31 20h58v61H31z" stroke-width="5"/>
    <path d="M42 20v22h33V20M43 65h34" stroke-width="4"/>
    <path d="m60 56 9-9m0 0h-8m8 0v8" stroke-width="3" opacity=".7"/>
  </g>}
  {id === 'memxt' && <g fill="none" stroke="currentColor">
    <circle cx="60" cy="48" r="13" stroke-width="5"/>
    <circle cx="29" cy="27" r="7" stroke-width="4"/><circle cx="91" cy="27" r="7" stroke-width="4"/>
    <circle cx="29" cy="70" r="7" stroke-width="4"/><circle cx="91" cy="70" r="7" stroke-width="4"/>
    <path d="m35 31 14 10m22 0 14-10M35 66l14-10m22 0 14 10" stroke-width="4"/>
  </g>}
  {id === 'opal' && <g fill="none" stroke="currentColor" stroke-linejoin="round">
    <path d="m60 16 31 32-31 32-31-32Z" stroke-width="5"/>
    <path d="m52 35 23 13-23 13Z" fill="currentColor" stroke-width="2"/>
    <path d="M18 48c0-17 19-31 42-31s42 14 42 31-19 31-42 31" stroke-width="2" opacity=".45"/>
  </g>}
  {id === 'opengtm' && <g fill="none" stroke="currentColor">
    <circle cx="60" cy="48" r="25" stroke-width="4"/><circle cx="60" cy="48" r="10" stroke-width="4"/>
    <path d="M60 13v15m0 40v15M25 48H10m100 0H95" stroke-width="4"/>
    <circle cx="26" cy="24" r="5" fill="currentColor"/><circle cx="94" cy="72" r="5" fill="currentColor"/>
    <path d="m30 27 13 9m34 24 13 9" stroke-width="3"/>
  </g>}
  {id === 'friday' && <g fill="none" stroke="currentColor" stroke-linecap="round">
    <path d="M29 27h62v47H29z" stroke-width="5"/><path d="M60 15v12" stroke-width="4"/><circle cx="60" cy="12" r="4" fill="currentColor"/>
    <circle cx="47" cy="46" r="4" fill="currentColor"/><circle cx="73" cy="46" r="4" fill="currentColor"/>
    <path d="M43 61h6l4-7 7 13 7-13 4 7h6M42 82h36" stroke-width="3"/>
  </g>}
</svg>

<style>
  .product-mark { display: block; width: 112px; height: auto; color: var(--machine-accent); filter: drop-shadow(5px 6px 0 rgba(5, 7, 12, .28)); }
</style>
