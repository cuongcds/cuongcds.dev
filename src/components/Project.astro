---
import type { Product } from '../lib/content';
interface Props { product: Product; level: number }
const { product: p, level } = Astro.props;
---
<article class={`level-card status-${p.status}`}>
  <div class="level-hud">
    <span class="level-num">LVL {level}</span>
    <span class="level-status">{p.status === 'coming-soon' ? 'soon' : p.status}</span>
    {p.stars ? <span class="level-score">★ {p.stars.toLocaleString('en-US')}</span> : null}
  </div>
  <div class="level-avatar" aria-hidden="true">{p.icon || '🕹️'}</div>
  <h3><a href={`/${p.id}/`}>{p.name}<span class="level-go" aria-hidden="true"> ▶</span></a></h3>
  <p class="level-tagline">{p.tagline}</p>
  <p class="level-meta">{[p.license, p.os.split(',')[0]].filter(Boolean).join(' · ')}</p>
</article>

<style>
  .level-card {
    position: relative; overflow: hidden; text-align: center;
    background-image: repeating-linear-gradient(0deg, rgba(21, 24, 33, .035) 0 2px, transparent 2px 4px);
  }
  .level-card::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 10px;
    background: #111722 linear-gradient(90deg, transparent 0 46%, rgba(57, 124, 121, .76) 46% 54%, transparent 54% 100%);
    background-size: 56px 100%;
  }
  .level-card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 6px;
    background: linear-gradient(90deg, #a94b42 0 33%, #b69a48 33% 66%, #397c79 66% 100%);
  }
  .level-card.status-alpha::before { background: #a94b42; }
  .level-card.status-beta::before { background: #397c79; }
  .level-card.status-coming-soon::before { background: repeating-linear-gradient(90deg, #b69a48 0 10px, #111722 10px 20px); }

  .level-hud { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-family: 'IBM Plex Mono', monospace; text-align: left; }
  .level-num { padding: 2px 8px; color: #111722; background: #c8b36a; border: 2px solid #151821; border-radius: 999px; font-weight: 700; font-size: .68rem; letter-spacing: .1em; }
  .level-status { padding: 2px 8px; border: 2px solid currentColor; border-radius: 999px; font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .status-live .level-status { color: #32633f; background: #dbe5d8; }
  .status-alpha .level-status { color: #873c35; background: #eadbd5; }
  .status-beta .level-status { color: #326e6a; background: #d7e4e1; }
  .status-coming-soon .level-status { color: #705c22; background: #ded2ad; }
  .level-score { margin-left: auto; padding: 2px 8px; color: #111722; background: #c8b36a; border: 2px solid #151821; border-radius: 999px; font-weight: 700; font-size: .7rem; }

  .level-avatar {
    display: grid; place-items: center; width: 72px; height: 72px; margin: 0 auto 12px;
    font-size: 2.1rem; background: #090c13; border: 3px solid #151821; border-radius: 14px;
    box-shadow: 3px 3px 0 #15101c, inset 0 0 18px rgba(57, 124, 121, .28);
    transition: transform .12s ease, border-color .12s ease, box-shadow .12s ease;
  }
  .level-card:hover .level-avatar { transform: scale(1.06); border-color: #b69a48; box-shadow: 3px 3px 0 #15101c, inset 0 0 18px rgba(182, 154, 72, .3); }

  .level-card h3 { margin: 0 0 6px; font-family: Bungee, system-ui, sans-serif; font-size: 1.05rem; font-weight: 400; letter-spacing: .01em; line-height: 1.2; text-transform: uppercase; text-shadow: 2px 2px 0 #c8b36a; }
  .level-card h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .level-go { display: inline-block; color: #a94b42; font-size: .7em; opacity: 0; transform: translateX(-6px); transition: opacity .12s ease, transform .12s ease; }
  .level-card:hover .level-go, .level-card:focus-within .level-go { opacity: 1; transform: none; }
  .level-tagline { margin: 0 0 10px; min-height: 2.6em; color: #3a4256; font-size: .95rem; line-height: 1.45; }
  .level-meta { margin: 0; padding-bottom: 6px; color: #5a6376; font-family: 'IBM Plex Mono', monospace; font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }
</style>
