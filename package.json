{
  "name": "palash-dev",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal portfolio and blog: Astro, Solid islands, Base UI, and Unhead",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run stats && astro build",
    "preview": "astro preview",
    "deploy": "npm run seo:audit && npm test && wrangler deploy",
    "typecheck": "astro check",
    "lint": "oxlint src scripts && astro check",
    "stats": "node scripts/refresh-stats.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:site": "node scripts/check-site.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "seo:audit": "npm run build && npm run test:site"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/solid-js": "^7.0.2",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "~7.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.26.0",
    "solid-js": "^1.9.13",
    "unhead": "^3.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.2.0",
    "oxlint": "^1.32.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.42.0"
  }
}
