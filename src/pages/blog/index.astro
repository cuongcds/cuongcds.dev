---
import Site from '../../layouts/Site.astro';
import { posts } from '../../lib/content';
import { pageByPath } from '../../lib/page-data';
---
<Site page={pageByPath('/blog/')}>
  <h1>Writing</h1><p>Notes on software, AI, and building things.</p>
  <p><a href="/rss.xml">Subscribe via RSS</a> · <a href="/search/">Search</a></p>
  {posts.map(post => <article><h2><a href={`/blog/${post.id}/`}>{post.title}</a></h2><time datetime={post.publishDate.toISOString()}>{post.publishDate.toISOString().slice(0, 10)}</time><p>{post.description}</p></article>)}
</Site>
