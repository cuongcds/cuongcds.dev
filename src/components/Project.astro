---
import type { Product } from '../lib/content';
import ProductMark from './ProductMark.astro';
interface Props { product: Product; level: number }
const { product: p, level } = Astro.props;
---
<article class={`machine-card machine-${p.id} status-${p.status}`}>
  <div class="machine-hud">
    <span class="machine-index">M-{String(level).padStart(2, '0')}</span>
    <span class="level-status">{p.status === 'coming-soon' ? 'soon' : p.status}</span>
    {p.stars ? <span class="level-score">★ {p.stars.toLocaleString('en-US')}</span> : null}
  </div>
  <div class="machine-body">
    <div class="machine-visual"><span class="machine-ghost" aria-hidden="true">{String(level).padStart(2, '0')}</span><ProductMark id={p.id} /></div>
    <div class="machine-copy">
      <p class="machine-type">{p.category.replace('Application', '')}</p>
      <h3><a href={`/${p.id}/`}>{p.name}<span class="level-go" aria-hidden="true"> →</span></a></h3>
      <p class="level-tagline">{p.tagline}</p>
      {p.proof[0] && <p class="machine-proof"><strong>{p.proof[0].value}</strong> {p.proof[0].label}</p>}
      <p class="level-meta">{[p.license, p.os.split(',')[0]].filter(Boolean).join(' · ')}</p>
    </div>
  </div>
</article>

<style>
  .machine-card {
    --machine-accent: #397c79;
    position: relative; overflow: hidden; min-height: 270px;
    background-color: #f5f0e5;
    background-image: linear-gradient(135deg, color-mix(in srgb, var(--machine-accent) 9%, transparent), transparent 42%), repeating-linear-gradient(0deg, rgba(21, 24, 33, .025) 0 2px, transparent 2px 5px);
  }
  .machine-card::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 10px;
    background: #111722 linear-gradient(90deg, transparent 0 46%, rgba(57, 124, 121, .76) 46% 54%, transparent 54% 100%);
    background-size: 56px 100%;
  }
  .machine-card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 6px;
    background: var(--machine-accent);
  }
  .machine-omnivoice { --machine-accent: #397c79; }
  .machine-bootable { --machine-accent: #a94b42; }
  .machine-memxt { --machine-accent: #71844c; }
  .machine-opal { --machine-accent: #66587c; }
  .machine-opengtm { --machine-accent: #9a693f; }
  .machine-friday { --machine-accent: #536d83; }

  .machine-hud { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-family: 'IBM Plex Mono', monospace; text-align: left; }
  .machine-index { color: var(--machine-accent); font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
  .level-status { padding: 2px 8px; border: 2px solid currentColor; border-radius: 999px; font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .status-live .level-status { color: #32633f; background: #dbe5d8; }
  .status-alpha .level-status { color: #873c35; background: #eadbd5; }
  .status-beta .level-status { color: #326e6a; background: #d7e4e1; }
  .status-coming-soon .level-status { color: #705c22; background: #ded2ad; }
  .level-score { margin-left: auto; color: #5a6376; font-size: .7rem; font-weight: 700; }
  .machine-body { display: grid; grid-template-columns: 132px minmax(0, 1fr); align-items: center; gap: 18px; }
  .machine-visual { position: relative; display: grid; place-items: center; min-height: 155px; border-right: 2px solid color-mix(in srgb, var(--machine-accent) 45%, transparent); }
  .machine-ghost { position: absolute; inset: auto auto -18px -8px; color: color-mix(in srgb, var(--machine-accent) 12%, transparent); font-family: Bungee, system-ui, sans-serif; font-size: 6rem; line-height: 1; }
  .machine-copy { position: relative; min-width: 0; text-align: left; }
  .machine-type { margin: 0 0 5px; color: var(--machine-accent); font-family: 'IBM Plex Mono', monospace; font-size: .66rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .machine-card h3 { margin: 0 0 7px; font-family: Bungee, system-ui, sans-serif; font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 400; letter-spacing: .01em; line-height: 1.2; text-transform: uppercase; }
  .machine-card h3 a { color: #171a22; text-decoration-color: var(--machine-accent); }
  .machine-card h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .level-go { display: inline-block; color: #a94b42; font-size: .7em; opacity: 0; transform: translateX(-6px); transition: opacity .12s ease, transform .12s ease; }
  .machine-card:hover .level-go, .machine-card:focus-within .level-go { opacity: 1; transform: none; }
  .level-tagline { margin: 0 0 12px; color: #3a4256; font-size: .96rem; line-height: 1.4; }
  .machine-proof { margin: 0 0 14px; color: #4a5160; font-size: .78rem; }
  .machine-proof strong { color: var(--machine-accent); font-family: 'IBM Plex Mono', monospace; font-size: .92rem; }
  .level-meta { margin: 0; padding-bottom: 6px; color: #6b7180; font-family: 'IBM Plex Mono', monospace; font-size: .64rem; letter-spacing: .07em; text-transform: uppercase; }
  @media (hover: hover) {
    .machine-card :global(.product-mark) { transition: transform .18s ease, filter .18s ease; }
    .machine-card:hover :global(.product-mark) { transform: translateY(-4px); filter: drop-shadow(7px 9px 0 rgba(5, 7, 12, .24)); }
  }
  @media (max-width: 620px) {
    .machine-card { min-height: 0; }
    .machine-body { grid-template-columns: 104px minmax(0, 1fr); gap: 14px; }
    .machine-visual { min-height: 138px; }
    .machine-visual :global(.product-mark) { width: 88px; }
    .machine-ghost { font-size: 4.5rem; }
  }
</style>
