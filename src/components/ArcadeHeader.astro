---
import '@fontsource/bungee/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { products } from '../lib/content';
import type { PageData } from '../lib/page-data';
import { SITE } from '../site.config';
interface Props { page: PageData }
const { page } = Astro.props;
const links = [['/', 'Work'], ['/blog/', 'Writing'], ['/lab/', 'Lab'], ['/media/', 'Media'], ['/resume/', 'Résumé'], ['/contact/', 'Contact'], ['/search/', 'Search']];
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="arcade-header">
  <div class="arcade-stage">
    <svg class="arcade-scene" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="arcade-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f04b32"/><stop offset="1" stop-color="#f5ae2e"/>
        </linearGradient>
        <linearGradient id="arcade-road" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#333846"/><stop offset="1" stop-color="#121722"/>
        </linearGradient>
      </defs>
      <rect width="1440" height="320" fill="url(#arcade-sky)"/>
      <g fill="#fff9dc" opacity=".85">
        <path d="M180 42h64v12h-64Zm16-13h36v12h-36Z"/>
        <path d="M1180 56h72v12h-72Zm20-13h40v12h-40Z"/>
      </g>
      <circle cx="720" cy="196" r="52" fill="#ffe65c"/>
      <path d="M0 190l110-40 90 28 130-42 155 48 130-32 94 27 150-44 135 48 132-28 144 34 100-30 70 17V320H0Z" fill="#3a3047"/>
      <path d="M0 214l210-24 170 18 230-26 186 30 208-24 190 22 246-18V320H0Z" fill="#202637"/>
      <path d="M520 320l152-124h96l152 124Z" fill="url(#arcade-road)"/>
      <path d="M713 204h14l6 16h-26Zm-11 34h40l8 22h-56Zm-16 46h56l10 28h-76Z" fill="#ffe65c"/>
      <g fill="#111722">
        <path d="M60 216c15-30 38-34 54-12-19-8-34 5-43 28Zm36-30l8-22 6 25-7 18Z"/>
        <path d="M1330 218c13-30 36-36 54-16-19-6-34 8-41 28Zm32-32l7-22 7 22-6 18Z"/>
      </g>
    </svg>
    <div class="arcade-bar">
      <nav class="product-select" aria-label="Products">
        <span class="hud-label" aria-hidden="true">Select</span>
        <ul>{products.map(product => <li><a href={`/${product.id}/`} aria-current={page.product?.id === product.id ? 'page' : undefined}>{product.name}</a></li>)}</ul>
      </nav>

    <a class="arcade-brand" href="/" rel="author" aria-label={`${SITE.author}, home`}>
      <span>Palash</span><span>Debnath</span>
    </a>

    <nav class="site-select" aria-label="Primary">
      <span class="hud-label" aria-hidden="true">Menu</span>
      <ul>{links.map(([href, label]) => <li><a href={href} aria-current={page.path === href ? 'page' : undefined}>{label}</a></li>)}</ul>
    </nav>
  </div>

    <p class="arcade-status"><span>Player 1</span><span>Software engineer</span><span>Agartala, India</span></p>
  </div>
</header>

<style>
  .skip-link { position: absolute; z-index: 100; top: 8px; left: 8px; padding: 10px 14px; color: #111722; background: #ffe65c; transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .arcade-header { color: #fff9dc; background: #111722; border-bottom: 5px solid #ffe65c; font-family: 'IBM Plex Mono', monospace; }
  .arcade-stage { position: relative; }
  .arcade-scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .arcade-bar { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); grid-template-areas: 'products brand menu'; align-items: center; gap: 20px; min-height: 128px; padding: 18px clamp(16px, 3vw, 48px) 34px; }
  .product-select { grid-area: products; }
  .site-select { grid-area: menu; justify-self: end; text-align: right; }
  .hud-label { display: block; margin-bottom: 7px; color: #ffe65c; font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; text-shadow: 1px 1px 0 rgba(5, 7, 12, .55); }
  .arcade-bar ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .site-select ul { justify-content: flex-end; }
  .arcade-bar nav a { display: inline-flex; align-items: center; min-height: 34px; padding: 4px 10px; color: #fff9dc; background: rgba(9, 12, 19, .62); border: 2px solid #66708c; border-radius: 999px; font-size: clamp(.65rem, .75vw, .78rem); text-decoration: none; white-space: nowrap; box-shadow: 2px 2px 0 rgba(5, 7, 12, .8); }
  .product-select li:nth-child(1) a { border-color: #ef4f3f; }
  .product-select li:nth-child(2) a { border-color: #3fd3cc; }
  .product-select li:nth-child(3) a { border-color: #a6da45; }
  .product-select li:nth-child(4) a { border-color: #c787ff; }
  .arcade-bar nav a:hover, .arcade-bar nav a[aria-current='page'] { color: #111722; background: #ffe65c; border-color: #ffe65c; }
  .arcade-bar a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .arcade-brand { grid-area: brand; display: grid; justify-items: center; color: #fff9dc; font-family: Bungee, system-ui, sans-serif; font-size: clamp(1.25rem, 2vw, 2rem); line-height: .88; text-align: center; text-decoration: none; text-transform: uppercase; text-shadow: 3px 3px 0 #7a1f14, 6px 6px 0 #15101c; transform: skew(-3deg); }
  .arcade-brand span:last-child { color: #ffe65c; }
  .arcade-status { position: relative; display: flex; justify-content: space-between; gap: 12px; margin: 0; padding: 8px clamp(16px, 3vw, 48px) 10px; color: #a6da45; background: rgba(9, 12, 19, .55); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
  @media (max-width: 1100px) {
    .arcade-bar { grid-template-columns: 1fr 1fr; grid-template-areas: 'brand brand' 'products menu'; }
    .arcade-brand { margin-block: 4px 10px; }
  }
  @media (max-width: 680px) {
    .arcade-bar { grid-template-columns: 1fr; grid-template-areas: 'brand' 'products' 'menu'; padding: 16px; }
    .product-select, .site-select { justify-self: stretch; text-align: left; }
    .site-select ul { justify-content: flex-start; }
    .arcade-bar nav a { min-height: 44px; padding-inline: 12px; font-size: .75rem; }
    .arcade-status { flex-wrap: wrap; }
  }
</style>
