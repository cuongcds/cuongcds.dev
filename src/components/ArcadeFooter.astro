---
import { SITE } from '../site.config';
---
<footer class="arcade-footer">
  <svg class="footer-scene" viewBox="0 0 1440 88" preserveAspectRatio="none" aria-hidden="true">
    <rect width="1440" height="88" fill="#111722"/>
    <path d="M0 34h1440v54H0Z" fill="#090c13"/>
    <path d="M0 36h1440M0 53h1440M0 70h1440M120 36L50 88m260-52-45 52m250-52-20 52m225-52v52m205-52 20 52m185-52 45 52m145-52 70 52" stroke="#3fd3cc" stroke-width="2" opacity=".56"/>
    <g fill="#ffe65c">
      <path d="M94 17h8l4 9-8 6-9-6Zm-15 15h7l4 8-7 5-8-5Zm31 4h7l4 8-7 5-8-5Z"/>
      <path d="M1338 17h8l5 9-9 6-9-6Zm-15 15h7l4 8-7 5-8-5Zm31 4h7l4 8-7 5-8-5Z"/>
    </g>
  </svg>
  <div class="footer-panel">
    <p class="stage-clear">Stage clear</p>
    <nav aria-label="Elsewhere">
      <a href="/rss.xml">RSS</a><span aria-hidden="true"> · </span>
      <a href={SITE.github} rel="me">GitHub</a><span aria-hidden="true"> · </span>
      <a href={SITE.x} rel="me">X</a><span aria-hidden="true"> · </span>
      <a href="/llms.txt">llms.txt</a>
    </nav>
    <p>© {new Date().getFullYear()} {SITE.author} · Continue?</p>
  </div>
</footer>

<style>
  .arcade-footer { margin-top: 48px; color: #fff9dc; background: #090c13; border-top: 5px solid #ffe65c; font-family: 'IBM Plex Mono', monospace; text-align: center; }
  .footer-scene { display: block; width: 100%; height: 72px; }
  .footer-panel { padding: 8px 16px 26px; }
  .stage-clear { margin: 0 0 12px; color: #ffe65c; font-family: Bungee, system-ui, sans-serif; font-size: clamp(1.3rem, 3vw, 2.2rem); text-transform: uppercase; text-shadow: 3px 3px 0 #ef4f3f; }
  .arcade-footer nav { line-height: 2.4; }
  .arcade-footer a { min-height: 44px; padding: 10px 3px; color: #3fd3cc; }
  .arcade-footer a:hover { color: #ffe65c; }
  .arcade-footer a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .arcade-footer p:last-child { color: #a6da45; font-size: .75rem; text-transform: uppercase; }
</style>
